/- Hidden test battery for T11 Product topology. -/
import LeanCraftGame.Referee
import LeanCraftGame.T11.Player

#no_sorry T11.productTopology
#no_sorry T11.Rectangle
#no_sorry T11.Cylinder
#no_sorry T11.allTrue
#level_start "Product topology"

#expect_true "product is generated by coordinate induced topologies" unfolding T11.productTopology :
  ∀ {α β : Type*} (τs : TopologicalSpace α) (τt : TopologicalSpace β),
    T11.productTopology τs τt =
      TopologicalSpace.induced Prod.fst τs ⊓ TopologicalSpace.induced Prod.snd τt

#expect_true "rectangle membership means coordinate membership" unfolding T11.Rectangle :
  ∀ {α β : Type*} (U : Set α) (V : Set β) (x : α) (y : β),
    (x, y) ∈ T11.Rectangle U V ↔ x ∈ U ∧ y ∈ V

#expect_true "cylinders restrict one coordinate" unfolding T11.Cylinder :
  ∀ {ι α : Type*} (i : ι) (U : Set α) (f : ι → α),
    f ∈ T11.Cylinder i U ↔ f i ∈ U

#expect_true "allTrue restricts every coordinate" unfolding T11.allTrue :
  ∀ f : Nat → Bool, f ∈ T11.allTrue ↔ ∀ n, f n = true

#level_report
