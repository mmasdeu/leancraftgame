/- Hidden test battery for Level Bases. -/
import LeanCraftGame.Referee
import LeanCraftGame.Lib.Topology
import LeanCraftGame.L64.Player

open Top

#no_sorry L64.IsBasis
#no_sorry L64.generated
#no_sorry L64.subbasic
#level_start "Bases"

#expect_true "The singletons {0}, {1}, {2} form a basis" unfolding L64.IsBasis :
  L64.IsBasis ({{0}, {1}, {2}} : Family 3)
#expect_true "{{0, 1}, {1}, {1, 2}} is a basis (and is not closed under unions)" unfolding L64.IsBasis :
  L64.IsBasis ({{0, 1}, {1}, {1, 2}} : Family 3)
#expect_false "{{0, 1}, {1, 2}} is not a basis: no member around 1 inside {1}" unfolding L64.IsBasis :
  L64.IsBasis ({{0, 1}, {1, 2}} : Family 3)
#expect_false "{{0}, {1}} does not cover {0, 1, 2}" unfolding L64.IsBasis :
  L64.IsBasis ({{0}, {1}} : Family 3)
#expect_true "Every topology is a basis of itself (Sierpiński space)" unfolding L64.IsBasis :
  L64.IsBasis sierpinski
#expect_true "The singletons generate the discrete topology" unfolding L64.generated :
  L64.generated ({{0}, {1}, {2}} : Family 3) = discrete 3
#expect_true "{{0, 1, 2}} generates the indiscrete topology" unfolding L64.generated :
  L64.generated ({Finset.univ} : Family 3) = indiscrete 3
#expect_true "{{0}, {0, 1}, {0, 1, 2}} generates the chain" unfolding L64.generated :
  L64.generated ({{0}, {0, 1}, Finset.univ} : Family 3) = chain3
#expect_true "The family generated by the basis {{0, 1}, {1}, {1, 2}} is a topology" unfolding L64.generated :
  Ref.IsTopology (L64.generated ({{0, 1}, {1}, {1, 2}} : Family 3))
#expect_true "subbasic covers {0, 1, 2}" unfolding L64.subbasic :
  ∀ x : Fin 3, ∃ U ∈ L64.subbasic, x ∈ U
#expect_false "subbasic is locally closed under intersections (it must not be)" unfolding L64.subbasic :
  ∀ U ∈ L64.subbasic, ∀ V ∈ L64.subbasic, ∀ x ∈ U ∩ V, ∃ W ∈ L64.subbasic, x ∈ W ∧ W ⊆ U ∩ V

#level_report
