      "lean": "example : ℤ → ℤ → ℕ := L16.distance",
      "message": "Keep `distance : ℤ → ℤ → ℕ`."
    },
    {
      "lean": "example : ℤ → Prop := L16.IsNegative",
      "message": "Keep `IsNegative : ℤ → Prop`."
    }
